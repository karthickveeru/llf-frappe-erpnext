  "html": "<!-- LLF Asset Tag Print Format -->\n<style>\n  .asset-tag-label {\n    width: 90mm;\n    height: 55mm;\n    border: 2px solid #000;\n    border-radius: 6px;\n    padding: 8px 10px;\n    font-family: Arial, sans-serif;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    page-break-after: always;\n  }\n  .label-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n  }\n  .label-org {\n    font-size: 10pt;\n    font-weight: bold;\n    color: #1a1a6e;\n    letter-spacing: 0.5px;\n  }\n  .label-id {\n    font-size: 7pt;\n    color: #555;\n    text-align: right;\n  }\n  .label-body {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 8px;\n    flex: 1;\n    margin-top: 4px;\n  }\n  .label-details {\n    flex: 1;\n    font-size: 7pt;\n    line-height: 1.5;\n  }\n  .label-details .field-row {\n    display: flex;\n    gap: 4px;\n  }\n  .label-details .field-label {\n    color: #888;\n    min-width: 56px;\n    font-size: 6pt;\n    text-transform: uppercase;\n    flex-shrink: 0;\n  }\n  .label-details .field-value {\n    font-weight: bold;\n    color: #111;\n    word-break: break-word;\n  }\n  .asset-name-large {\n    font-size: 9.5pt;\n    font-weight: bold;\n    color: #000;\n    margin-bottom: 3px;\n  }\n  .state-badge {\n    display: inline-block;\n    font-size: 6pt;\n    font-weight: bold;\n    padding: 1px 5px;\n    border-radius: 3px;\n    background: #1a1a6e;\n    color: #fff;\n    margin-bottom: 3px;\n  }\n  .qr-section {\n    width: 28mm;\n    text-align: center;\n    flex-shrink: 0;\n  }\n  .qr-section img {\n    width: 26mm;\n    height: 26mm;\n    border: 1px solid #ddd;\n  }\n  .qr-section .qr-label {\n    font-size: 5pt;\n    color: #888;\n    margin-top: 2px;\n  }\n  .label-footer {\n    border-top: 1px solid #ddd;\n    padding-top: 3px;\n    font-size: 5.5pt;\n    color: #888;\n    word-break: break-all;\n  }\n  @media print {\n    body { margin: 0; }\n    .asset-tag-label { border: 2px solid #000; }\n  }\n</style>\n\n<div class=\"asset-tag-label\">\n\n  <!-- Header -->\n  <div class=\"label-header\">\n    <div class=\"label-org\">Learning Links Foundation</div>\n    <div class=\"label-id\">\n      {{ doc.name }}<br>\n      <span style=\"color:#c00\">{{ doc.status }}</span>\n    </div>\n  </div>\n\n  <!-- Body -->\n  <div class=\"label-body\">\n\n    <!-- Left: asset details -->\n    <div class=\"label-details\">\n      <div class=\"asset-name-large\">{{ doc.asset_name }}</div>\n\n      {% if doc.asset_state %}\n      <div style=\"margin-bottom:3px;\">\n        <span class=\"state-badge\">{{ doc.asset_state }}</span>\n      </div>\n      {% endif %}\n\n      {% if doc.llf_asset_tag %}\n      <div class=\"field-row\">\n        <span class=\"field-label\">Tag</span>\n        <span class=\"field-value\" style=\"font-size:5.5pt;\">{{ doc.llf_asset_tag }}</span>\n      </div>\n      {% endif %}\n\n      {% if doc.serial_no %}\n      <div class=\"field-row\">\n        <span class=\"field-label\">Serial</span>\n        <span class=\"field-value\">{{ doc.serial_no }}</span>\n      </div>\n      {% endif %}\n\n      {% if doc.location %}\n      <div class=\"field-row\">\n        <span class=\"field-label\">Location</span>\n        <span class=\"field-value\">{{ doc.location }}</span>\n      </div>\n      {% endif %}\n\n      {% if doc.allocated_to_user %}\n      <div class=\"field-row\">\n        <span class=\"field-label\">Custodian</span>\n        <span class=\"field-value\">{{ doc.allocated_to_user }}</span>\n      </div>\n      {% elif doc.allocated_to_non_user %}\n      <div class=\"field-row\">\n        <span class=\"field-label\">Custodian</span>\n        <span class=\"field-value\">{{ doc.allocated_to_non_user }}</span>\n      </div>\n      {% endif %}\n\n      {% if doc.project %}\n      <div class=\"field-row\">\n        <span class=\"field-label\">Project</span>\n        <span class=\"field-value\">{{ doc.project }}</span>\n      </div>\n      {% endif %}\n\n      {% if doc.warranty_expiry_date %}\n      <div class=\"field-row\">\n        <span class=\"field-label\">Warranty</span>\n        <span class=\"field-value\">\n          {% if doc.warranty_period %}{{ doc.warranty_period }}M · {% endif %}\n          Exp: {{ doc.warranty_expiry_date }}\n        </span>\n      </div>\n      {% elif doc.warranty_period %}\n      <div class=\"field-row\">\n        <span class=\"field-label\">Warranty</span>\n        <span class=\"field-value\">{{ doc.warranty_period }} months</span>\n      </div>\n      {% endif %}\n\n      {% if doc.insured %}\n      <div class=\"field-row\">\n        <span class=\"field-label\">Insured</span>\n        <span class=\"field-value\">\n          {{ doc.insured }}{% if doc.insured_till %} · Till {{ doc.insured_till }}{% endif %}\n        </span>\n      </div>\n      {% endif %}\n    </div>\n\n    <!-- Right: QR code -->\n    <div class=\"qr-section\">\n      {% if doc.qr_code %}\n        <img src=\"{{ doc.qr_code }}\" alt=\"QR Code\">\n      {% else %}\n        <div style=\"width:26mm;height:26mm;border:1px dashed #ccc;display:flex;align-items:center;justify-content:center;font-size:6pt;color:#aaa;\">\n          No QR\n        </div>\n      {% endif %}\n      <div class=\"qr-label\">Scan to open record</div>\n    </div>\n\n  </div>\n\n  <!-- Footer -->\n  {% if doc.llf_asset_tag %}\n  <div class=\"label-footer\">{{ doc.llf_asset_tag }}</div>\n  {% endif %}\n\n</div>",
